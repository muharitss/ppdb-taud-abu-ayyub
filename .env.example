# Supabase Public Configuration
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Prisma / PostgreSQL Connection (Supabase Session Pooler port 5432 recommended for IPv4)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Cloudinary Configuration (Upload 3 foto: Bukti Bayar, KK, Akte)
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_API_KEY=your-api-key
VITE_CLOUDINARY_API_SECRET=your-api-secret

