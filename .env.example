# Supabase Public Configuration
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Prisma / PostgreSQL Connection (Supabase Session Pooler port 5432 recommended for IPv4)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

